{
  "name": "hive-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node scripts/native-abi.mjs node && vitest run",
    "check": "npm run build && npm test",
    "build:desktop": "node scripts/build-desktop.mjs && vite build",
    "desktop": "npm run build:desktop && node scripts/native-abi.mjs electron && electron .",
    "build:cli": "node scripts/build-cli.mjs",
    "cli": "npm run build:cli && node dist/cli.cjs",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "main": "dist/desktop/main.cjs",
  "bin": {
    "hive": "dist/cli.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "node-pty": "^1.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.4.11",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
